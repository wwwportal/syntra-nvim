#!/usr/bin/env bash
# ==============================================================================
# tasks: Source-First Task Graph & Taskwarrior CLI
# Mirrors Neovim's :Tasks command directly in the terminal.
#
# Commands:
#   tasks [list] [dir]        List in-tree tasks ordered by Tier A/B/C
#   tasks --json [dir]        Export task DAG as machine-readable JSON
#   tasks fix [--apply] [dir] Convert unstructured TODOs into verified contracts
#   tasks verify [dir]        Verify LexLean specs via proof replay
#   tasks add [file] <TODO|FIXME|SPEC>:<desc>  Scaffold a structured task contract
#   tasks tw [args...]        Interact with Taskwarrior
#   tasks --help              Show this help message
# ==============================================================================

set -euo pipefail

# Locate lgcc compiler binary
LGCC_BIN=""
if command -v lgcc &>/dev/null; then
    LGCC_BIN="$(command -v lgcc)"
elif [ -x "$HOME/code/syntra-nvim/bin/lgcc" ]; then
    LGCC_BIN="$HOME/code/syntra-nvim/bin/lgcc"
elif [ -x "$HOME/.local/bin/lgcc" ]; then
    LGCC_BIN="$HOME/.local/bin/lgcc"
elif [ -x "$HOME/.config/nvim/bin/lgcc" ]; then
    LGCC_BIN="$HOME/.config/nvim/bin/lgcc"
fi

if [ -z "$LGCC_BIN" ]; then
    echo "tasks: Error: native lgcc binary not found in PATH or standard locations." >&2
    echo "       Please run ./setup.sh in syntra-nvim to install lgcc." >&2
    exit 1
fi

show_help() {
    cat <<EOF
tasks: Source-First Task Graph & Taskwarrior CLI (Dual Neovim / Terminal)

Usage:
  tasks [COMMAND] [OPTIONS]

Commands:
  tasks, tasks list [dir]        Scan in-tree task DAG and display tiered report (Tier A/B/C)
  tasks --json [dir]             Export in-tree task DAG as formatted JSON
  tasks fix [--apply] [dir]      Synthesize structured task contracts from unstructured comments
  tasks verify [dir]             Execute formal LexLean proof replay via prod_codegen
  tasks add [file] <tag>:<desc>  Add a task contract (tag: TODO, FIXME, SPEC)
  tasks tw, tasks taskwarrior    View or manage global Taskwarrior tasks
  tasks help, --help, -h         Display this help guide

Examples:
  tasks                          # View all in-tree tasks in current repository
  tasks fix                      # Dry-run contract synthesis for lazy comments
  tasks fix --apply              # Automatically rewrite lazy comments into verified contracts
  tasks verify                   # Verify all 36+ machine-checked Lean 4 theorems
  tasks tw                       # View pending Taskwarrior agenda
EOF
}

CMD="${1:-list}"

case "$CMD" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    list)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --lint-tasks "$TARGET_DIR"
        ;;
    --json|-j|json)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --lint-tasks --json "$TARGET_DIR"
        ;;
    fix|--fix|fix-tasks|--fix-tasks)
        shift || true
        exec "$LGCC_BIN" --fix-tasks "$@"
        ;;
    verify|--verify|verify-specs|--verify-specs)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --verify-specs "$TARGET_DIR"
        ;;
    tw|taskwarrior)
        shift || true
        if ! command -v task &>/dev/null; then
            echo "tasks: Error: 'task' (Taskwarrior) executable not found in PATH." >&2
            exit 1
        fi
        exec task "$@"
        ;;
    add)
        shift || true
        if [ $# -lt 1 ]; then
            echo "tasks add: missing task specification." >&2
            echo "Usage: tasks add [file] <TODO|FIXME|SPEC>:<description>" >&2
            exit 1
        fi
        TARGET_FILE=""
        SPEC_STR=""
        if [ $# -ge 2 ] && [ -f "$1" ]; then
            TARGET_FILE="$1"
            shift
            SPEC_STR="$*"
        else
            SPEC_STR="$*"
        fi

        # Parse KIND:DESC
        KIND="TODO"
        DESC="$SPEC_STR"
        if [[ "$SPEC_STR" =~ ^(TODO|FIXME|SPEC):(.*)$ ]]; then
            KIND="${BASH_REMATCH[1]}"
            DESC="$(echo "${BASH_REMATCH[2]}" | sed 's/^[ \t]*//')"
        fi

        if [ -z "$TARGET_FILE" ]; then
            # Default to first modified or first candidate source file
            TARGET_FILE="$(git ls-files '*.rs' '*.lua' 2>/dev/null | head -n 1 || true)"
        fi

        if [ -z "$TARGET_FILE" ] || [ ! -f "$TARGET_FILE" ]; then
            echo "tasks add: Target file not found: $TARGET_FILE" >&2
            exit 1
        fi

        # Generate slug
        SLUG="$(echo "$DESC" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//' | cut -d'-' -f1-3)"
        [ -z "$SLUG" ] && SLUG="task"
        STEM="$(basename "$TARGET_FILE" | cut -d. -f1 | tr '_' '-')"
        TASK_ID="${STEM}-${SLUG}"

        # Choose comment prefix based on extension
        EXT="${TARGET_FILE##*.}"
        PREFIX="//"
        if [ "$EXT" = "lua" ]; then
            PREFIX="--"
        elif [ "$EXT" = "py" ] || [ "$EXT" = "sh" ] || [ "$EXT" = "bash" ]; then
            PREFIX="#"
        fi

        TEMP_FILE="$(mktemp)"
        cat <<EOF > "$TEMP_FILE"
$PREFIX $KIND($TASK_ID | tier:B): $DESC
$PREFIX Description: $DESC
$PREFIX Criterion: review: "$DESC is implemented and verified"
EOF
        cat "$TARGET_FILE" >> "$TEMP_FILE"
        mv "$TEMP_FILE" "$TARGET_FILE"
        echo "● Scaffolded $KIND contract '$TASK_ID' into $TARGET_FILE"
        ;;
    *)
        # Default to lint-tasks if argument is a directory or path
        exec "$LGCC_BIN" --lint-tasks "$@"
        ;;
esac
